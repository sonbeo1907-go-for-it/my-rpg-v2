{
    "name":  "northern-prisma-v2",
    "version":  "2.0.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev":  "next dev --port 3001",
                    "build":  "next build",
                    "start":  "node scripts/preview-static.mjs",
                    "validate":  "node scripts/validate.mjs",
                    "test":  "node --test test/*.test.js",
                    "test:e2e":  "playwright test",
                    "typecheck":  "tsc --noEmit",
                    "art":  "node scripts/generate-art.mjs",
                    "tauri":  "node scripts/tauri.mjs",
                    "desktop:dev":  "node scripts/tauri.mjs dev",
                    "desktop:build":  "node scripts/tauri.mjs build",
                    "desktop:check":  "node scripts/tauri.mjs --test",
                    "preview":  "node scripts/preview-static.mjs"
                },
    "dependencies":  {
                         "@fontsource-variable/noto-serif":  "^5.3.0",
                         "next":  "16.4.3",
                         "react":  "19.3.1",
                         "react-dom":  "19.3.1",
                         "@tauri-apps/api":  "^2"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.56.1",
                            "@types/node":  "^22.0.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "typescript":  "^5.9.3",
                            "@tauri-apps/cli":  "^2"
                        }
}