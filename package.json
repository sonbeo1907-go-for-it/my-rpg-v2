{
    "name":  "the-prisma-origin",
    "version":  "2.0.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev":  "next dev --port 3001",
                    "build":  "next build",
                    "start":  "node scripts/preview-static.mjs",
                    "validate":  "node scripts/validate.mjs",
                    "test":  "node --test test/*.test.js",
                    "test:e2e":  "playwright test",
                    "typecheck":  "tsc --noEmit",
                    "art":  "node scripts/generate-art.mjs",
                    "tauri":  "node scripts/tauri.mjs",
                    "desktop:dev":  "node scripts/tauri.mjs dev",
                    "desktop:build":  "node scripts/tauri.mjs build",
                    "desktop:check":  "node scripts/tauri.mjs --test",
                    "preview":  "node scripts/preview-static.mjs",
                    "graph": "node scripts/graphify.mjs",
                    "graph:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-graphify.ps1",
                    "graph:build": "node scripts/graphify.mjs build",
                    "graph:update": "node scripts/graphify.mjs update",
                    "graph:query": "node scripts/graphify.mjs query",
                    "graph:explain": "node scripts/graphify.mjs explain",
                    "graph:path": "node scripts/graphify.mjs path",
                    "graph:affected": "node scripts/graphify.mjs affected",
                    "graph:stats": "node scripts/graphify.mjs god-nodes --top 8"
                },
    "dependencies":  {
                         "@fontsource-variable/noto-serif":  "^5.3.0",
                         "next":  "16.4.3",
                         "react":  "19.3.1",
                         "react-dom":  "19.3.1",
                         "@tauri-apps/api":  "^2"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.56.1",
                            "@types/node":  "^22.0.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "typescript":  "^5.9.3",
                            "@tauri-apps/cli":  "^2"
                        }
}
